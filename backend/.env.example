SECRET_KEY=django-insecure-change-this-in-production-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (PostgreSQL default, SQLite fallback if DATABASE_URL not set or unreachable)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_doc_db

# Groq LLM API Configuration (Primary Ultra-Fast Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI Fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB & Vector Store
CHROMA_PERSIST_DIRECTORY=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
TIME_ZONE=Asia/Kolkata
